{
  "name": "sara-cosmeticos-backend",
  "version": "1.0.0",
  "description": "API + painel admin para a loja Sara Cosméticos",
  "main": "src/server.js",
  "engines": {
    "node": ">=22.5.0"
  },
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "seed": "node src/seed.js",
    "admin:seed": "node src/seed.js",
    "db:inspect": "node src/inspect-db.js",
    "db:backup": "node src/backup-db.js",
    "check": "node --check src/server.js && node --check public/admin/admin.js && node --check public/admin/login.js && node --check public/admin/dashboard.js",
    "test": "node --test tests/api-smoke.test.js"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^7.4.1",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.3.0"
  }
}
